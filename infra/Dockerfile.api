FROM node:24-bookworm-slim AS chatgpt-ui
WORKDIR /build
COPY apps/chatgpt/package.json apps/chatgpt/package-lock.json ./
RUN npm ci
COPY apps/chatgpt/ ./
RUN npm run build

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS runtime
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_DEFAULT_TIMEOUT=120
WORKDIR /srv/runbuoy
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY server/pyproject.toml ./
COPY server/app ./app
COPY server/worker ./worker
COPY --from=chatgpt-ui /build/dist/index.html ./app/static/chatgpt.html
COPY server/alembic.ini ./
COPY server/migrations ./migrations
RUN pip install --no-cache-dir --default-timeout "$PIP_DEFAULT_TIMEOUT" \
    --index-url "$PIP_INDEX_URL" ".[postgres]"
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
